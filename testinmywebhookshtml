<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Urgent Button</title>
<style>
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    background: #1e1f22;
    font-family: system-ui, sans-serif;
    color: #fff;
  }
  button {
    padding: 18px 40px;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: #fff;
    background: #ed4245;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: transform .1s, opacity .2s;
  }
  button:hover { transform: scale(1.04); }
  button:active { transform: scale(.97); }
  button:disabled { opacity: .5; cursor: not-allowed; }
  #status { min-height: 1.5em; font-size: .95rem; }
</style>
</head>
<body>
  <button id="urgentBtn">SEND URGENT</button>
  <div id="status"></div>

<script>
  // Paste your Discord webhook URL here
  const WEBHOOK_URL = "https://discord.com/api/webhooks/1563997087249596517/CLOruXLWYTS8mpaYUxfsRM4uQM6vifivlZEQ1Fnst4hTBqqKE9W5J4u2K5ZrCgXO_yY-";

  const btn = document.getElementById("urgentBtn");
  const status = document.getElementById("status");

  btn.addEventListener("click", async () => {
    btn.disabled = true;
    status.textContent = "Sending...";
    try {
      const res = await fetch(WEBHOOK_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ content: "URGENT!" })
      });
      if (!res.ok) throw new Error("HTTP " + res.status);
      status.textContent = "Sent!";
    } catch (err) {
      status.textContent = "Failed: " + err.message;
    } finally {
      setTimeout(() => { btn.disabled = false; }, 2000);
    }
  });
</script>
</body>
</html>
